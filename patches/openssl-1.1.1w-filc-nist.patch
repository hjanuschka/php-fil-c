+#ifdef __FILC__
+/* Fil-C pointer capabilities cannot survive integer masking. */
+static PTR_SIZE_INT nist_barrier(PTR_SIZE_INT mask)
+{
+    volatile PTR_SIZE_INT value = mask;
+    return value;
+}
+
+static void nist_select_words(BN_ULONG *dst, const BN_ULONG *a,
+                              const BN_ULONG *b, PTR_SIZE_INT mask, int top)
+{
+    int i;
+
+    for (i = 0; i < top; i++)
+        dst[i] = (a[i] & nist_barrier(mask)) |
+                 (b[i] & nist_barrier(~mask));
+}
+
+static BN_ULONG nist_addsub_words(BN_ULONG *dst, const BN_ULONG *src,
+                                  const BN_ULONG *mod, int subtract, int top)
+{
+    BN_ULONG added[BN_NIST_521_TOP];
+    BN_ULONG borrow = bn_sub_words(dst, src, mod, top);
+    BN_ULONG carry = bn_add_words(added, src, mod, top);
+    PTR_SIZE_INT mask = 0 - (PTR_SIZE_INT)subtract;
+
+    nist_select_words(dst, dst, added, mask, top);
+    return (borrow & nist_barrier(mask)) |
+           (carry & nist_barrier(~mask));
+}
+#endif
